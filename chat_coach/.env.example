# Скопируй в .env и заполни. Файл .env в репозиторий не попадает.

# Токен бота у @BotFather
BOT_TOKEN=

# Ключ с console.anthropic.com
ANTHROPIC_API_KEY=

# Модель. По умолчанию claude-opus-5.
# Дешевле: claude-sonnet-5 (примерно вдвое), claude-haiku-4-5 (впятеро).
CHAT_COACH_MODEL=claude-opus-5

# Глубина рассуждений: low, medium, high, xhigh, max.
# medium — разумный баланс для разговорной задачи.
CHAT_COACH_EFFORT=medium

# Где лежит база. Обычно трогать не надо: по умолчанию она ложится
# в «данные/бот.sqlite3» рядом с программой, а в докере путь ставит
# сам compose. Путь вида /data/bot.sqlite3 на Windows означает корень
# диска C: — туда не пустят, и бот не запустится.
#CHAT_COACH_DB=

# Telegram id того, кому можно делать возвраты звёзд командой /возврат.
# Пусто — команда не работает ни у кого. Свой id узнать можно у @userinfobot.
CHAT_COACH_ADMIN=
