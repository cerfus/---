# Скопируй в .env и заполни. Файл .env в репозиторий не попадает.

# Токен бота у @BotFather
BOT_TOKEN=

# Ключ с console.anthropic.com
ANTHROPIC_API_KEY=

# Модель. По умолчанию claude-opus-5.
# Дешевле: claude-sonnet-5 (примерно вдвое), claude-haiku-4-5 (впятеро).
CHAT_COACH_MODEL=claude-opus-5

# Глубина рассуждений: low, medium, high, xhigh, max.
# medium — разумный баланс для разговорной задачи.
CHAT_COACH_EFFORT=medium

# Где лежит база. В контейнере это примонтированный том.
CHAT_COACH_DB=/data/bot.sqlite3
