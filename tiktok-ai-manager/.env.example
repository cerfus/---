# Шаблон. Реальный .env генерируется scripts/bootstrap_db.sh и в git не попадает.
TIKTOK_DB=tiktok_manager
TIKTOK_DSN_OWNER=postgresql://tiktok_owner:CHANGE_ME@127.0.0.1:5432/tiktok_manager
TIKTOK_DSN_RW=postgresql://tiktok_rw:CHANGE_ME@127.0.0.1:5432/tiktok_manager
TIKTOK_DSN_RO=postgresql://tiktok_ro:CHANGE_ME@127.0.0.1:5432/tiktok_manager

# Мобильный пульт (Phase 6.5). Пустые значения = интеграция выключена.
# Реальные значения задаются только в .env или в окружении, в git не попадают.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
