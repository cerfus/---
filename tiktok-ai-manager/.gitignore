__pycache__/
*.pyc
*.session
logs/
data/media/
db/*.db

# видеофайлы в git не кладутся: репозиторий хранит манифест с хешем и
# ссылкой, а не бинарники. Каталог остаётся, чтобы контракт ингеста был
# виден без запуска кода.
data/assets/incoming/*
!data/assets/incoming/.gitkeep
config/settings.toml

# журнал обращений мобильного пульта: операционная телеметрия с
# Telegram-идентификаторами, в репозиторий не кладётся
data/mobile/

# метки времени прогонов: наблюдаемость, а не данные. В git не кладутся,
# чтобы детерминированные артефакты не менялись от самого факта запуска
data/runtime/

# секреты: отрицание ДОЛЖНО идти после правил, которые оно отменяет
.env
.env.*
!.env.example
